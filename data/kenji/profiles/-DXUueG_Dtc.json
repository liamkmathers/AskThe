  "profile": {
    "video_id": "kenji:-DXUueG_Dtc",
    "purpose": "Announce the pre-order launch of KAN's full knife line directly to Kenji's viewers, with the cut that would have gone to Kickstarter donated to Feeding America and signed copies of Kenji's books bundled with knife sets.",
    "video_type": "other",
    "thesis": "Kenji and KAN founder Barney Lund present the new KAN knife lineup, including an upgraded chef's knife, as an unpaid fundraiser for Feeding America that also offers signed copies of Kenji's books.",
    "key_takeaways": [
      "The video is explicitly not a paid sponsorship; instead of Kickstarter's cut, 5% goes to Feeding America.",
      "The upgraded 8-inch Concourse chef knife switches its core steel from AUS10 to VG10, rounds the spine, stays balanced at the bolster and shows more visible Damascus layering.",
      "The new lineup includes a 6-inch santoku, slicer, bread knife, steak knife set of four, utility knife, paring knife and an upcoming boning knife, with G10 or ebony handles and hammered or non-hammered options.",
      "Knife bundles include a signed copy of The Food Lab or Every Night Is Pizza Night; signed books are only available with bundles.",
      "The knives are hand-wash only, even with G10 handles, and pre-orders are targeted to ship before Christmas.",
      "Order at kankitchen.com with promo code 'kenji' for an extra discount; a separate knife sharpening video is promised."
    ],
    "outline": [
      {
        "title": "Intro and the Feeding America fundraiser",
        "summary": "Kenji introduces Barney Lund of KAN, says the video is not sponsored, and explains that the money normally taken by Kickstarter will go to Feeding America. Barney explains how pre-ordering works.",
        "first_segment": 0,
        "last_segment": 1
      },
      {
        "title": "Concourse chef knife upgrades",
        "summary": "Barney describes the upgraded 8-inch chef knife: a VG10 core instead of AUS10, a rounded spine, balance at the bolster, and lessons learned from the first Kickstarter.",
        "first_segment": 1,
        "last_segment": 2
      },
      {
        "title": "Damascus pattern and six-inch santoku",
        "summary": "They cover the more visible Damascus layering applied across the line, show the slicer, bread knife and six-inch santoku prototypes, and go through the handle and finish options.",
        "first_segment": 3,
        "last_segment": 3
      },
      {
        "title": "Signed copies of Kenji's books",
        "summary": "Signed copies of The Food Lab or Every Night Is Pizza Night will ship with knife bundles. Kenji describes the children's book's message about family, multiculturalism and expanding your palate.",
        "first_segment": 3,
        "last_segment": 5
      },
      {
        "title": "Rest of the lineup, care and ordering",
        "summary": "Barney runs through the steak knife set, utility knife, paring knife and upcoming boning knife. He stresses hand washing, gives the pre-order timing and box options, and points viewers to kankitchen.com and the promo code.",
        "first_segment": 5,
        "last_segment": 7
      },
      {
        "title": "Wrap-up and knife sharpening",
        "summary": "Kenji repeats that this is not paid, promises a separate video on sharpening knives, and signs off.",
        "first_segment": 7,
        "last_segment": 7
      }
    ],

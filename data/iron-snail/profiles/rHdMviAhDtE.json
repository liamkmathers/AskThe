  "profile": {
    "video_id": "iron-snail:rHdMviAhDtE",
    "purpose": "Rank the down jackets and brands that viewers named as their favourites, bought by the creator, going from cheapest to most expensive, with a rundown of each jacket's construction and features and who it suits.",
    "video_type": "ranking",
    "thesis": "Viewer-recommended down jackets from Uniqlo to Canada Goose are compared in price order. The creator argues the best value lies somewhere in between, and that a jacket only works for you if your goals match its designer's.",
    "key_takeaways": [
      "Jackets are presented from lowest to highest price, roughly 15 in total, drawn from a viewer poll of favourite down jacket brands.",
      "Fill power, stitch-through vs. box-baffle vs. seamless (heat-bonded) construction, and shell fabric denier are explained as the key specs.",
      "The Uniqlo Seamless Down Parka's care label warns its bonding resin degrades over time, so the seams may eventually fail.",
      "The Decathlon jacket is presented as an outstanding value at $250 with box baffles, 800 fill down and many features, compared with the barebones North Face at the same price.",
      "Ultralight jackets (Ghost Whisperer 10D, Montbell Plasma 1000 7D) are discussed as fragile and more than most people need.",
      "Rab, Feathered Friends and Montbell are discussed for technical details such as baffle mapping, tuck stitching and skip stitches.",
      "Fjällräven's waxed G-1000 shell is water resistant rather than waterproof and needs upkeep.",
      "A heritage segment covers Rocky Mountain Featherbed, the Filson Waxed Down Jacket and an All Blues Co. Karakoram.",
      "The $1,400 Canada Goose Wyndham is described as an overbuilt jacket from a brand that pivoted to luxury, and the creator returned it."
    ],
    "outline": [
      {
        "title": "Intro and ranking format",
        "summary": "Teaser of the jackets, then how the list was built from a viewer poll and the plan to go from cheapest to most expensive, noting who each jacket is for.",
        "first_segment": 0,
        "last_segment": 2
      },
      {
        "title": "Down basics and Uniqlo Seamless Down Parka",
        "summary": "Explains fill power and stitch-through vs. seamless construction, cuts open the Uniqlo parka, and discusses its care label warning that the bonding resin will degrade.",
        "first_segment": 3,
        "last_segment": 7
      },
      {
        "title": "Eddie Bauer Superior Down Parka",
        "summary": "Covers the $175 Eddie Bauer parka (650 fill, waterproof, stitch-through) and the First Ascent line.",
        "first_segment": 7,
        "last_segment": 8
      },
      {
        "title": "Decathlon jacket breakdown",
        "summary": "Details the $250 Decathlon down jacket's features: chest pockets, storm placket and cuffs, 800 fill duck blend, box-baffle construction (explained). Interrupted by a sponsor read.",
        "first_segment": 9,
        "last_segment": 13
      },
      {
        "title": "The North Face Hydrenalite",
        "summary": "Compares the barebones $250 North Face lifestyle jacket to the Decathlon, discusses the brand's fashion history and 'brand tax', and mentions the Summit Series.",
        "first_segment": 13,
        "last_segment": 17
      },
      {
        "title": "Patagonia Downdrift",
        "summary": "Covers Patagonia's 600 fill heritage-style Downdrift jacket, its sustainability and warranty, and its rough nylon hood.",
        "first_segment": 17,
        "last_segment": 18
      },
      {
        "title": "Mountain Hardwear Ghost Whisperer",
        "summary": "Mentions the creator's favourite Mountain Hardwear Subzero jacket, then discusses the ultralight 10-denier Ghost Whisperer and its fragility.",
        "first_segment": 18,
        "last_segment": 20
      },
      {
        "title": "Rab mountaineering features",
        "summary": "Shows Rab's climbing-oriented features such as the foldable hood, high hand pockets, 20D shell, 800 fill down and baffle mapping.",
        "first_segment": 20,
        "last_segment": 22
      },
      {
        "title": "Montbell Plasma 1000",
        "summary": "Covers the 7-denier, 1000 fill Montbell Plasma 1000, its value, a 30D version, and its skip-stitch construction.",
        "first_segment": 22,
        "last_segment": 23
      },
      {
        "title": "Fjällräven Greenland No. 1",
        "summary": "Explains Fjällräven's avoidance of newer chemical treatments and its waxable G-1000 polycotton shell, which is water resistant but not waterproof.",
        "first_segment": 23,
        "last_segment": 25
      },
      {
        "title": "Feathered Friends Volant",
        "summary": "Praises Feathered Friends' craftsmanship: 900 fill down, down-filled pockets and tuck-stitch construction.",
        "first_segment": 25,
        "last_segment": 27
      },
      {
        "title": "Heritage down brands",
        "summary": "Quick looks at a Rocky Mountain Featherbed jacket with a leather yoke, the Filson Waxed Down Jacket, and an All Blues Co. Karakoram based on Eddie Bauer's 1960s design.",
        "first_segment": 27,
        "last_segment": 29
      },
      {
        "title": "Canada Goose Wyndham Parka",
        "summary": "Unboxes the $1,400 Canada Goose Wyndham, lists its specs, and explains its overbuilt Arctic heritage and pivot to luxury. Other Canadian and US makers get a mention.",
        "first_segment": 29,
        "last_segment": 31
      }

    "corrections": [
      {
        "segment_id": "iron-snail:ZYitFMuxj3k:s0004",
        "note": "Corrects the age of the Well Dressed Dad blog posts from 10 years ago to 13 years ago."
      },
      {
        "segment_id": "iron-snail:ZYitFMuxj3k:s0004",
        "note": "Notes the Mark 7 Ventile immersion suit was introduced in 1951, six years after WWII ended, despite the wartime framing of the story."
      },
      {
        "segment_id": "iron-snail:ZYitFMuxj3k:s0010",
        "note": "Corrects his earlier, often repeated claim that sailors treating sails with linseed were the first to waterproof fabric. Indigenous Mesoamerican and North American peoples and people in China did so thousands of years earlier."
      },
      {
        "segment_id": "iron-snail:ZYitFMuxj3k:s0013",
        "note": "Clarifies that the earlier footage of water beading beautifully was not Ventile; the water wasn't touching Ventile at all."
      },
      {
        "segment_id": "iron-snail:ZYitFMuxj3k:s0016",
        "note": "Clarifies that the packages shown are not vintage Ventile but are for a different video."
      },
      {
        "segment_id": "iron-snail:ZYitFMuxj3k:s0027",
        "note": "Specifies that his 1950s garment is a single-layer tropical-weight flight suit, not an immersion suit."
      },
      {
        "segment_id": "iron-snail:ZYitFMuxj3k:s0030",
        "note": "The supposedly untreated 1950s flight suit beads water, contradicting the claim in segment 16 that vintage Ventile was untreated."
      },
      {
        "segment_id": "iron-snail:ZYitFMuxj3k:s0033",
        "note": "The flight suit described in segment 25 as made from Ventile is a twill weave, not Ventile's signature Oxford weave. He concludes it is probably gabardine, though it was sold as Ventile."
      },
      {
        "segment_id": "iron-snail:ZYitFMuxj3k:s0037",
        "note": "The DWR treatment worked on ordinary cotton better than he had been told it would."
      }
    ],

  "profile": {
    "video_id": "iron-snail:IQrhvbWN1Uw",
    "purpose": "Compare the Wrangler Cowboy Cut 13MWZ jean with the Levi's 501 Rinsed and the Levi's 501 Shrink-to-Fit on denim, construction, pocket placement, fit and shrinkage, ending in a verdict.",
    "video_type": "comparison",
    "thesis": "The video argues that Wrangler Cowboy Cut jeans have heavier broken-twill denim, stronger construction (back rivets, flat-felled seams) and higher back pockets at roughly half the price of Levi's, while Levi's offer darker denim and a dressier drape. The final verdict wavers between the 501 Shrink-to-Fit and the Wrangler.",
    "key_takeaways": [
      "Levi's 501 use about 12 oz right hand twill denim; the Wrangler Cowboy Cut uses 14.75 oz broken twill.",
      "Broken twill was Wrangler's answer to leg twist and stiffness in unsanforized right hand twill, letting them use heavier denim that still feels soft.",
      "Wrangler kept back rivets and uses flat-felled seams; Levi's replaced rivets with bar tacks.",
      "The video frames Levi's as the dress jean and Wrangler as the work jean.",
      "Wrangler back pockets sit higher, and older Levi's pockets were higher and smaller than modern ones.",
      "Measured differences: Wranglers have higher pockets and a wider thigh, knee and leg opening; sizing up one in Levi's may approximate the Wrangler fit.",
      "The 501 Shrink-to-Fit was bought two sizes up, and the measured waist does not follow vanity sizing.",
      "Washed without very hot water and not dried, the STFs shrank only slightly smaller than the rinsed 501s and looked best.",
      "The creator first says neither wins, then picks the 501 STF, then says Wrangler wins because of the higher pockets."
    ],
    "outline": [
      {
        "title": "Intro and overview",
        "summary": "Sets up the claim that Wrangler Cowboy Cuts beat Levi's at half the price, notes an upset at the end, and lists what will be compared.",
        "first_segment": 0,
        "last_segment": 1
      },
      {
        "title": "Denim: weight and broken twill vs right hand twill",
        "summary": "Compares Levi's 12 oz right hand twill with Wrangler's 14.75 oz broken twill, explaining the 1947 history, leg twist, sanforization and why broken twill allowed heavier, softer jeans.",
        "first_segment": 1,
        "last_segment": 4
      },
      {
        "title": "Construction: rivets, bar tacks and seams",
        "summary": "Covers Wrangler keeping back rivets versus Levi's bar tacks, Wrangler's flat-felled seams, and Levi's as the dress jean versus Wrangler as the work jean.",
        "first_segment": 4,
        "last_segment": 5
      },
      {
        "title": "Pocket height history: vintage vs modern Levi's and Wrangler",
        "summary": "Compares a 90s pair of Levi's, a 1955 Levi's recreation, and modern Levi's and Wranglers, showing how Levi's pockets got larger and lower while Wrangler's stayed high.",
        "first_segment": 6,
        "last_segment": 7
      },
      {
        "title": "Measurements and fit comparison",
        "summary": "Goes through the measurements of all three jeans, including pocket height, thigh, knee and leg opening, plus STF sizing and the lack of vanity sizing.",
        "first_segment": 7,
        "last_segment": 8
      },
      {
        "title": "Why Levi's lowered their pockets",
        "summary": "Explains that lower, relaxed back pockets can hide or smooth a larger backside while higher pockets emphasize the butt, and that overall fit matters more.",
        "first_segment": 9,
        "last_segment": 10
      },
      {
        "title": "Shrink-to-Fit results",
        "summary": "Shows the shrunk 501 STF measurements against the rinsed 501s, then gives washing advice: avoid very hot water and the dryer.",
        "first_segment": 10,
        "last_segment": 11
      },
      {
        "title": "Verdict",
        "summary": "Weighs Levi's drape, dark denim and contrast stitching against Wrangler's heavier denim, construction, rivets and higher pockets, with a shifting final pick.",
        "first_segment": 11,
        "last_segment": 12
      }
    ],

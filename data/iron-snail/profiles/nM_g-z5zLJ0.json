{
  "platform_id": "nM_g-z5zLJ0",
  "profile": {
    "video_id": "iron-snail:nM_g-z5zLJ0",
    "purpose": "Tests the claim that Levi's 'don't make them like they used to' by comparing a 1960s pair of Levi's 501s, a Levi's Vintage Clothing (LVC) replica of that era and a regular modern 501, detail by detail.",
    "video_type": "comparison",
    "thesis": "A side-by-side look at vintage, LVC replica and modern Levi's 501s, covering small design details, stitching, pocket bags, selvedge denim and loom technology, cotton fibre, shrinkage and leg twist, bartacking and inflation-adjusted price, to judge where quality has and hasn't declined.",
    "key_takeaways": [
      "Covers small design changes: paper (Jacron) vs leather patches, the arcuate stitching, the red tab lettering, button material and copper vs aluminium rivets.",
      "Covers 1960s fit quirks: no vanity sizing, and lengths shorter than the tag states.",
      "Compares stitches per inch and pocket bag material across the three pairs.",
      "Explains selvedge denim, Cone Mills, and shuttle vs projectile looms, plus long vs short cotton fibres.",
      "Covers unsanforized shrinkage of up to 10% and how much leg twist each pair shows.",
      "Explains bartacking as a replacement for rivets and compares the bartacks on vintage and modern back pockets.",
      "Compares the 1960s price adjusted for inflation with today's price, and notes production moved to Mexico and Egypt."
    ],
    "outline": [
      {
        "title": "Vintage vs modern jeans",
        "summary": "Introduces the three pairs being compared (a $1,300 1960s 501, a $260 LVC replica and an $80 modern 501) and the question of whether Levi's quality has dropped. Credits the vintage reseller who supplied the jeans.",
        "first_segment": 0,
        "last_segment": 1
      },
      {
        "title": "Small design differences",
        "summary": "Compares the Jacron paper patches with leather patches, the arcuate stitching, 1960s sizing quirks, the red tab lettering, button material and rivet metals.",
        "first_segment": 1,
        "last_segment": 4
      },
      {
        "title": "Sponsorship break",
        "summary": "Sponsor read for Ritual vitamins, framed by an unopened MacBook Pro box.",
        "first_segment": 4,
        "last_segment": 5
      },
      {
        "title": "Stitching and materials",
        "summary": "Compares stitches per inch and pocket bag fabric, and the selvedge denim used by the vintage pair (Cone Mills) and the LVC pair (Japan).",
        "first_segment": 5,
        "last_segment": 7
      },
      {
        "title": "Denim manufacturing",
        "summary": "Explains shuttle, projectile and modern looms, denim width, longer vs shorter cotton fibres, unsanforized shrinkage and the leg twist on each pair.",
        "first_segment": 7,
        "last_segment": 8
      },
      {
        "title": "Durability and bartacking",
        "summary": "Explains how bartacks replaced rivets and compares the back-pocket bartacks on the vintage and modern pairs. Includes a correction about why the vintage bartack is shallower.",
        "first_segment": 8,
        "last_segment": 10
      },
      {
        "title": "Price and conclusion",
        "summary": "Compares 1960s prices adjusted for inflation for Levi's, Wrangler and Filson with today's prices, and discusses offshore production and lower-grade cotton. Gives the final verdict and asks what to compare next.",
        "first_segment": 10,
        "last_segment": 11
      }
    ],

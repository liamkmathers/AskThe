{
  "platform_id": "GMM_Hl1fTQ0",
  "profile": {
    "video_id": "iron-snail:GMM_Hl1fTQ0",
    "purpose": "Try on and compare roughly 15 internet-recommended t-shirts, from budget multipacks to loopwheeled Japanese and heavyweight shirts, with shrink test results for each, ending in a set of superlative awards.",
    "video_type": "ranking",
    "thesis": "Michael works through the t-shirts the internet most often recommends, grouped from cheap to premium. For each he covers fabric, fit, collar construction and shrinkage. Instead of a strict best-to-worst list he gives high-school-style superlatives, and he leaves out shirts he got for free.",
    "key_takeaways": [
      "Shirts covered: Kirkland, Uniqlo heavyweight crew and Uniqlo Supima, Whitesville, Velva Sheen, Asket, Buck Mason Yuma hemp, Dehen 1920, A New Medium, The Real McCoy's, Merz b. Schwanen 215, Lady White Co. and Wonder Looper.",
      "Each shirt gets a shrink test reported as a percentage change in width and length.",
      "Collar construction is a recurring point: bound and ribbed collars versus self-fabric collars, binding tape, and diagonal ribbing.",
      "Explains Supima (extra-long staple) cotton, compact knits, hemp blends, loopwheel knitting and naturally coloured Fox Fiber cotton.",
      "Identifies the Merz b. Schwanen 215 as the shirt Jeremy Allen White wears in The Bear and compares it with other loopwheeled shirts.",
      "Four shirts were given to him for free and are excluded from the final awards; he says he paid about $420 for the rest.",
      "He swapped an 11-place ranking for superlatives such as heaviest, softest, best value, longest, best graphic and an overall winner."
    ],
    "outline": [
      {
        "title": "Introduction to t-shirts",
        "summary": "Shows a one-of-one Wonder Looper heavyweight prototype and explains the plan to review about 15 internet-recommended t-shirts with superlatives. Also explains that free shirts are excluded from the final awards.",
        "first_segment": 0,
        "last_segment": 1
      },
      {
        "title": "Affordable t-shirt options: Kirkland",
        "summary": "Reviews the Costco Kirkland six-pack: price per shirt, length, softness, fit and collar construction, plus its shrink test.",
        "first_segment": 1,
        "last_segment": 2
      },
      {
        "title": "Premium budget shirts: Uniqlo",
        "summary": "Covers the Uniqlo heavyweight crew neck with its bound, ribbed collar and the Uniqlo Supima cotton tee. Explains extra-long staple cotton, notes the Supima collar sag, and gives both shrink tests.",
        "first_segment": 2,
        "last_segment": 3
      },
      {
        "title": "Vintage style shirts: Whitesville",
        "summary": "Reviews Whitesville's tight, underwear-style Americana tee, its softness and its taped collar, with a shrink test.",
        "first_segment": 3,
        "last_segment": 4
      },
      {
        "title": "Sponsor message",
        "summary": "Surfshark VPN sponsor read.",
        "first_segment": 4,
        "last_segment": 5
      },
      {
        "title": "Authentic vintage brands: Velva Sheen",
        "summary": "Covers Velva Sheen's history as a 1930s Cincinnati company revived by a Japanese owner, how it compares with Whitesville, and its old-fashioned underwear-shirt feel.",
        "first_segment": 5,
        "last_segment": 6
      },
      {
        "title": "High-tech compact shirts: Asket",
        "summary": "Reviews the Asket tee's very compact knit and smooth hand, which showed zero shrinkage because it is pre-washed.",
        "first_segment": 6,
        "last_segment": 6
      },
      {
        "title": "Eco-friendly materials: Buck Mason Yuma hemp",
        "summary": "Reviews Buck Mason's hemp-cotton Yuma tee and the benefits of hemp, with notes on the self-fabric collar and shrink test.",
        "first_segment": 6,
        "last_segment": 7
      },
      {
        "title": "American made graphics: Dehen 1920",
        "summary": "Reviews Dehen 1920's mediumweight graphic tee in cream: collar, blind stitch hem and shrinkage.",
        "first_segment": 7,
        "last_segment": 8
      },
      {
        "title": "Loop wheel technology: A New Medium",
        "summary": "Introduces loopwheeled t-shirts through A New Medium, the in-house brand of Iron Shop Provisions. This shirt was received free and has no shrink data.",
        "first_segment": 8,
        "last_segment": 8
      },
      {
        "title": "High-end Japanese brands: The Real McCoy's",
        "summary": "Reviews The Real McCoy's dense, coarse fabric and diagonally ribbed collar, with a shrink test.",
        "first_segment": 8,
        "last_segment": 9
      },
      {
        "title": "The Bear shirt analysis: Merz b. Schwanen 215",
        "summary": "Tries on the Merz b. Schwanen 215 worn in The Bear and compares it with A New Medium and Wonder Looper loopwheeled shirts. Covers its underarm gussets and its shrink test.",
        "first_segment": 9,
        "last_segment": 11
      },
      {
        "title": "Premium fashion options: Lady White Co.",
        "summary": "Reviews a Lady White Co. mesh tee and the brand's calm, well-fitting style; it had zero shrinkage.",
        "first_segment": 11,
        "last_segment": 12
      },
      {
        "title": "Sustainable cotton options: Fox Fiber",
        "summary": "Introduces Wonder Looper's founders and explains Sally Fox's naturally coloured Fox Fiber cotton, with examples from other brands. Ends with the Wonder Looper Fox Fiber shrink test.",
        "first_segment": 12,
        "last_segment": 13
      },
      {
        "title": "Ultimate heavyweight shirts: Wonder Looper",
        "summary": "Covers Wonder Looper's rare Ultimate Pima cotton tee and the triple heavyweight prototype, compared against Champion Reverse Weave.",
        "first_segment": 13,
        "last_segment": 14
      },
      {
        "title": "T-shirt superlatives",
        "summary": "Explains the switch from a numbered ranking to superlatives, then hands out awards and names an overall winner, excluding free shirts.",
        "first_segment": 14,
        "last_segment": 15
      }
    ],

{
  "platform_id": "pPBCSjP8-qs",
  "profile": {
    "video_id": "iron-snail:pPBCSjP8-qs",
    "purpose": "A tour of every watch in the creator's 13-piece collection, from cheap Casios to his dad's Rolex. He tells the personal story behind each one and explains why he has decided to sell the collection. Short sponsored segments for Vaer watches run between sections.",
    "video_type": "other",
    "thesis": "Looking back over the collection, the creator finds that his happiest watch memories come from simpler times and from gifts to others. Watches bought during his overwork years carry few good memories, so he plans to sell the collection and focus on his life.",
    "key_takeaways": [
      "The collection is shown roughly from cheapest to most expensive: Casio F-91W, CW&T Solid State Watch, Casio F108WHC-7B, G-Shock DW5600 and GWM5610, Hamilton Khaki Pilot Pioneer, vintage Omegas, vintage Tudor Big Rose, Rolex Explorer II, Zenith Chronomaster Revival Shadow, Rolex Explorer I and the Rolex Sea-Dweller bought for his dad.",
      "Each watch is tied to a personal memory, such as college, friends, Taylor or his family.",
      "The Hamilton Pilot Pioneer was lost during the move to Maine.",
      "Explains Tudor's origin as Hans Wilsdorf's more affordable sister brand to Rolex, built with Rolex Oyster case parts.",
      "The Vaer segments cover the solar C3 Korean field watch, a dive watch with a 150 m water resistance guarantee, the meca-quartz R1 Rally chronograph and the A12 Dirty Dozen field watch.",
      "Two watches he gave away, a vintage Omega for his friend Ronnie's wedding and a Rolex Sea-Dweller for his dad, made him realise he should sell the rest.",
      "He says he is selling the collection to step back from overwork and spend more time with Taylor."
    ],
    "outline": [
      {
        "title": "Introduction to the collection",
        "summary": "Compares the $16 Casio F-91W with a far pricier non-adjustable lookalike, previews the collection and sets up the premise that he is selling everything.",
        "first_segment": 0,
        "last_segment": 2
      },
      {
        "title": "Getting ready and sponsorship",
        "summary": "Introduces Vaer as the sponsor and explains that Vaer vignettes will appear between categories, then greets viewers.",
        "first_segment": 2,
        "last_segment": 3
      },
      {
        "title": "Sentimental Casio watches",
        "summary": "Covers the Casio F108WHC-7B gifted by his friend Danny and the G-Shock DW5600 he wore through college with the hour chime on.",
        "first_segment": 3,
        "last_segment": 5
      },
      {
        "title": "Tough solar Casio and memories",
        "summary": "Covers the G-Shock GWM5610 that Casio sent him, with Multiband 6 and Tough Solar, plus the solar Vaer C3 Korean field watch. Ends with a story about testing Casio water resistance on a kayaking trip with Taylor.",
        "first_segment": 5,
        "last_segment": 8
      },
      {
        "title": "The missing Hamilton watch",
        "summary": "Shows a Vaer dive watch with a 150 m water resistance guarantee, then holds a mock funeral for the Hamilton Pilot Pioneer lost in the move to Maine.",
        "first_segment": 9,
        "last_segment": 11
      },
      {
        "title": "Vintage Omega watches",
        "summary": "Covers a 1962 vintage Omega from his days selling vintage watches on Reddit and the vintage Omega he gave Ronnie for his wedding.",
        "first_segment": 12,
        "last_segment": 13
      },
      {
        "title": "Tudor and Vaer vignettes",
        "summary": "Covers the vintage Tudor Big Rose and Tudor's history as Hans Wilsdorf's more affordable brand built with Rolex Oyster case parts.",
        "first_segment": 13,
        "last_segment": 15
      },
      {
        "title": "Racing chronographs",
        "summary": "Vaer vignettes for the R1 Rally meca-quartz chronograph and the A12 Dirty Dozen field watch.",
        "first_segment": 16,
        "last_segment": 17
      },
      {
        "title": "High-end watch spotlight",
        "summary": "Briefly covers the Rolex Explorer II and its 24-hour, two-time-zone function, which he says is too new to hold many memories.",
        "first_segment": 17,
        "last_segment": 18
      },
      {
        "title": "Zenith history and the Explorer",
        "summary": "Covers the high-beat Zenith Chronomaster Revival Shadow and the burnout period in Brooklyn when he bought it. Then tells the story of the Rolex Explorer I passing back and forth between him and Ronnie.",
        "first_segment": 18,
        "last_segment": 22
      },
      {
        "title": "Reevaluating the collection",
        "summary": "Introduces the Rolex Sea-Dweller bought for his fisherman dad and reflects on overwork and the lack of happy memories tied to recent purchases. Announces he will sell the collection.",
        "first_segment": 23,
        "last_segment": 26
      }
    ],

        "last_segment": 7
      },
      {
        "title": "Channel future and repairs",
        "summary": "Talks about a hoped-for Patreon to fund reviews, then his plan to self-repair the jeans and wash them more often so they last longer.",
        "first_segment": 7,
        "last_segment": 8
      },
      {
        "title": "Conclusion",
        "summary": "Sums up that they are holding up as expected for cheap jeans, asks viewers to subscribe and mentions the channel's approaching one-year mark.",
        "first_segment": 8,
        "last_segment": 8
      }

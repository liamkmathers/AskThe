      {
        "title": "Levi's 501 modifications",
        "summary": "Explains the side lines left from tapering the jeans and then removing the stitches to go back to a straight leg, and gives his view on straight leg fits.",
        "first_segment": 0,
        "last_segment": 2
      },
      {
        "title": "Repairs and sewing",
        "summary": "Describes the poorly sewn patch on the cuffs after a seam ripper accident and his plan to replace it with a denim patch.",
        "first_segment": 2,
        "last_segment": 2
      },
      {
        "title": "Denim wear history",
        "summary": "Covers how long and how much he has worn them, the $30 price, the light denim weight, the sizing and fit, cuffing, and wearing them for runs and walks.",
        "first_segment": 2,
        "last_segment": 4
      },
      {
        "title": "Fade progress and damage",
        "summary": "Reviews the vintage-style fades versus high-contrast denim, the phone-pocket rip, worn-through pocket bags, whiskers, yellowing and honeycombs.",
        "first_segment": 4,
        "last_segment": 6
      },
      {
        "title": "Crotch blowout analysis",
        "summary": "Shows the thinning holes developing in the crotch and notes his limited experience judging raw denim longevity.",

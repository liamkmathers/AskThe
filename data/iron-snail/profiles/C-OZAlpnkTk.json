{
  "platform_id": "C-OZAlpnkTk",
  "profile": {
    "video_id": "iron-snail:C-OZAlpnkTk",
    "purpose": "Rank 12 men's t-shirts across a range of weights and prices from best to worst, including a few unranked bonus shirts, with a pick for best value.",
    "video_type": "ranking",
    "thesis": "A follow-up t-shirt ranking that is not limited to heavyweight tees. Each shirt is judged on fabric weight, cotton type, collar construction, fit, origin and price, ending with a final ranked list and a best-value pick.",
    "key_takeaways": [
      "Each shirt is described by fabric weight in ounces, cotton type (ring spun, supima, slub, loopwheel), collar construction, country of manufacture and price.",
      "Unbleached Apparel, the Huckberry slub pocket tee and Wonder Looper's The Beast are bonus shirts left out of the ranking because of personal connections.",
      "Bronson is named best value, especially its loopwheel tee at about $27 on sale.",
      "The final ranking, from 8th to 1st: Sunspel, Patagonia, Adidas Human Race, Carhartt K87, Velva Sheen, Buck Mason, Bronson loopwheel, Standard & Strange Wakayama Special.",
      "Velva Sheen and Buck Mason swap places in the ranking after the list is first read out.",
      "Wonder Looper's The Beast is presented as the heaviest t-shirt in the world, at about 12.1 oz, and can be custom chain stitched.",
      "The tip given for better fit is to iron t-shirts."
    ],
    "outline": [
      {
        "title": "The quest for the best tee",
        "summary": "Intro with Taylor and Risa from Wonder Looper. Explains that this ranking is not focused only on heavyweight tees and will name a best value pick.",
        "first_segment": 0,
        "last_segment": 1
      },
      {
        "title": "Unbleached and Carhartt",
        "summary": "Covers the bonus Unbleached Apparel 6.1 oz undyed ring spun tee made in Haiti, then the Carhartt K87 heavyweight loose fit tee made in Guatemala.",
        "first_segment": 1,
        "last_segment": 2
      },
      {
        "title": "Bronson manufacturing tees",
        "summary": "Covers Bronson's 9 oz heavyweight tee in the 'embryo' color, made in China, and Bronson's loopwheel tee with a stitched-over collar at about $27.",
        "first_segment": 2,
        "last_segment": 4
      },
      {
        "title": "Lighter weight options",
        "summary": "Covers a bonus slub cotton pocket tee made in Peru and the Buck Mason 4.2 oz pocket tee made in the USA for $42.",
        "first_segment": 4,
        "last_segment": 5
      },
      {
        "title": "Premium and branded tees",
        "summary": "Covers the Patagonia organic graphic tee at 4.5 oz and the heavy, silky Adidas x Pharrell Human Race premium basics tee.",
        "first_segment": 5,
        "last_segment": 6
      },
      {
        "title": "Velva Sheen and Sunspel",
        "summary": "Covers the pigment-dyed Velva Sheen tee, which runs very small, and the very light $90 Sunspel supima cotton tee made in England.",
        "first_segment": 6,
        "last_segment": 8
      },
      {
        "title": "Standard & Strange special",
        "summary": "Covers the Standard & Strange Wakayama Special loopwheel tee at about $100 and its ribbed fold-over collar; it is the favorite shirt.",
        "first_segment": 8,
        "last_segment": 9
      },
      {
        "title": "The Beast by Bayside",
        "summary": "Covers Wonder Looper's The Beast, claimed as the heaviest t-shirt in the world at about 12.1 oz. Also explains why ounce figures can mislead and that the shirts can be custom chain stitched.",
        "first_segment": 9,
        "last_segment": 10
      },
      {
        "title": "Final rankings and outro",
        "summary": "Names Bronson best value, reads out the ranking from 8th to 1st with one reordering, and signs off with a blooper.",
        "first_segment": 10,
        "last_segment": 12
      }
    ],

# Data: raw files are the source of truth and are committed; everything derived
# from them (the database, caches) is rebuildable and ignored, except profiles,
# which cost an LLM call each to rebuild (D17).
data/*
!data/*/
data/*/*
!data/*/raw/
!data/*/profiles/
!data/*/channel.tsv
!data/*/channel.json
.env
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Data: raw files are the source of truth and are committed; everything derived
# from them (the database, caches) is rebuildable and ignored, except profiles,
# which cost an LLM call each to rebuild (D17).
data/*
!data/*/
data/*/*
!data/*/raw/
!data/*/profiles/
!data/*/channel.tsv
!data/*/channel.json
!data/*/bio.json
# Lists of found videos to choose from, for creators without one channel.
!data/*/candidates.tsv
!data/*/web_candidates.md
.env
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Agent worktrees (local copies of the repo)
.claude/worktrees/
